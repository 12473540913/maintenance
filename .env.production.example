# Database API
MONGODB_URI=mongodb+srv://<YOUR USER>:<YOUR PASSWORD>@<YOUR CLUSTER>.<YOUR DOMAIN>.mongodb.net/maintenance?appName=<YOUR APP NAME>
MONGODB_DB=maintenance
PORT=8787

# auth-service
# Use the same JWT_SECRET and AUTH_COOKIE_NAME configured in auth-service.
# In auth-service prod config, set ATLAS_URI_MAINTENANCE to this same database URI
# so maintenance accounts live in the maintenance database. If API/frontend are on
# separate subdomains, also set AUTH_COOKIE_DOMAIN_MAINTENANCE=.lnks.info.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=auth_session
AUTH_BASE_URL=https://auth.lnks.info
VITE_AUTH_BASE_URL=https://auth.lnks.info

# Optional if the frontend calls a separately deployed API origin.
# VITE_API_BASE_URL=https://maintenance.lnks.info/api

# Optional CORS restriction when frontend/API are split across origins.
# ALLOWED_ORIGINS=https://maintenance.lnks.info