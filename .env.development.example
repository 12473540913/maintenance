# Database API
MONGODB_URI=mongodb+srv://<YOUR USER>:<YOUR PASSWORD>@<YOUR CLUSTER>.<YOUR DOMAIN>.mongodb.net/maintenance-dev?appName=<YOUR APP NAME>
MONGODB_DB=maintenance-dev
PORT=8787

# auth-service
# Use the same JWT_SECRET and AUTH_COOKIE_NAME configured in auth-service.
# In auth-service dev config, set ATLAS_URI_MAINTENANCE to this same database URI
# so maintenance accounts live in the maintenance database.
JWT_SECRET=replace-with-a-long-random-secret
AUTH_COOKIE_NAME=auth_session
AUTH_BASE_URL=https://auth-dev-46917854791.us-central1.run.app
VITE_AUTH_BASE_URL=https://auth-dev-46917854791.us-central1.run.app

# Web API
# Leave unset to use the Vite /api proxy in development.
# VITE_API_BASE_URL=http://localhost:8787/api